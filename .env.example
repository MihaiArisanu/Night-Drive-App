# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=nightdrive
DB_HOST=db
DB_PORT=5432

# Zen Engine Secrets
ZEN_RO_PASSWORD=your_zen_readonly_password
INTERNAL_SECRET=your_super_secret_internal_key
ZEN_ENGINE_URL=http://zen_engine:8000
OVERPASS_URLS=https://z.overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Third-Party APIs
GOOGLE_MAPS_API_KEY=AIzaSyDummyKeyForGoogleMapsAPI1234567
SPONTANEOUS_RADIUS_METERS=1000
SPONTANEOUS_MAX_ROAD_DISTANCE_METERS=3000
SPONTANEOUS_LOCATION_MAX_AGE_SECONDS=12
SPONTANEOUS_MAX_ACCURACY_METERS=100
SPONTANEOUS_OFFER_TTL_SECONDS=10
SPONTANEOUS_PAIR_COOLDOWN_SECONDS=300
SPONTANEOUS_EVALUATION_LOCK_SECONDS=30
FIREBASE_PROJECT_ID=nightdrive-main

# Security & Authentication
JWT_SECRET=your_jwt_signing_secret_key_change_in_production
ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=false

# Email Service (For Forgot Password & Feedback)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_USER=your_minio_user
MINIO_PASSWORD=your_minio_password
MINIO_PUBLIC_URL=http://localhost:9000

# LiveKit development voice server
# Replace the IP with the LAN address of the machine running Docker.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=192.168.1.100
LIVEKIT_PUBLIC_URL=ws://192.168.1.100:7880
